import PoincareMT.Definitions.M21AsymptoticVolume

/-!
# M22 universal noncollapsing output data

`UniversalNoncollapsingData` is an output witness.  In particular, its
positive constant is generated by the M22 theorem and is not an input chosen
by a caller.
-/

set_option autoImplicit false

open scoped Manifold ContDiff Bundle ENNReal Topology

universe u

namespace PoincareMT

structure UniversalNoncollapsingData where
  universal_kappa : ℝ
  universal_kappa_pos : 0 < universal_kappa

end PoincareMT
